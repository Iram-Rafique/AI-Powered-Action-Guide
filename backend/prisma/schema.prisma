generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model documents {
  document_id       Int               @id @default(autoincrement())
  user_id           Int
  document_name     String            @db.VarChar(255)
  upload_date       DateTime?         @default(now()) @db.Timestamp(6)
  processing_status String            @default("pending") @db.VarChar(30)
  users             users             @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  extracted_items   extracted_items[]
}

model extracted_items {
  item_id       Int       @id @default(autoincrement())
  document_id   Int
  item_type     String    @db.VarChar(30)
  description   String
  due_date      DateTime? @db.Date
  action_status String?   @db.VarChar(30)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  documents     documents @relation(fields: [document_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  user_id       Int         @id @default(autoincrement())
  name          String      @db.VarChar(100)
  email         String      @unique @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  documents     documents[]
}
